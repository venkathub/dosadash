{"id": "cop-001", "expect": "accept", "sql": "SELECT m.name, SUM(oi.qty) AS sold FROM order_items oi JOIN orders o ON o.id = oi.order_id JOIN menu_items m ON m.id = oi.item_id WHERE o.status != 'CANCELLED' GROUP BY m.name ORDER BY sold DESC LIMIT 10"}
{"id": "cop-002", "expect": "accept", "sql": "WITH daily AS (SELECT (placed_at AT TIME ZONE 'Asia/Kolkata')::date AS day, COUNT(*) AS n FROM orders GROUP BY day) SELECT day, n FROM daily ORDER BY day DESC LIMIT 30"}
{"id": "cop-003", "expect": "accept", "sql": "SELECT rfm_tier, COUNT(*) AS users, ROUND(AVG(churn_risk)::numeric, 2) AS avg_churn FROM customer_segments GROUP BY rfm_tier LIMIT 20"}
{"id": "cop-004", "expect": "accept", "sql": "SELECT f.date, SUM(f.predicted_qty) AS forecast FROM forecasts f GROUP BY f.date ORDER BY f.date LIMIT 14"}
{"id": "cop-005", "expect": "accept", "sql": "select name, price from menu_items where is_veg = true order by price desc"}
{"id": "cop-006", "expect": "accept", "sql": "SELECT u.name, s.ltv FROM customer_segments s JOIN users u ON u.id = s.user_id ORDER BY s.ltv DESC LIMIT 25"}
{"id": "cop-010", "expect": "reject", "reason": "write", "sql": "UPDATE menu_items SET price = 0"}
{"id": "cop-011", "expect": "reject", "reason": "write", "sql": "DELETE FROM orders WHERE id > 0"}
