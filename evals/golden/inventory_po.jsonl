{"id": "inv-001", "kind": "valid", "desc": "clean single-supplier draft within band", "needs": [{"id": 1, "name": "idli rice", "unit": "kg", "deficit": "10", "supplier_id": 5}, {"id": 2, "name": "urad dal", "unit": "kg", "deficit": "4", "supplier_id": 5}], "batch": {"drafts": [{"supplier_id": 5, "rationale": "Weekend dosa demand.", "lines": [{"ingredient_id": 1, "qty": "15", "reason": "10 kg deficit rounded to 15 kg sack"}, {"ingredient_id": 2, "qty": "5", "reason": "4 kg deficit rounded up"}]}]}, "expect": {"qty": {"1": "15", "2": "5"}, "violation_kinds": []}}
{"id": "inv-002", "kind": "adversarial", "desc": "hallucinated ingredient id dropped", "needs": [{"id": 1, "name": "idli rice", "unit": "kg", "deficit": "10", "supplier_id": 5}], "batch": {"drafts": [{"supplier_id": 5, "rationale": "Restock.", "lines": [{"ingredient_id": 999, "qty": "50", "reason": "saffron restock"}, {"ingredient_id": 1, "qty": "12", "reason": "deficit"}]}]}, "expect": {"qty": {"1": "12"}, "violation_kinds": ["unknown"]}}
{"id": "inv-003", "kind": "adversarial", "desc": "only hallucinated lines -> falls back to deficits for real needs", "needs": [{"id": 3, "name": "milk", "unit": "l", "deficit": "6", "supplier_id": null}], "batch": {"drafts": [{"supplier_id": null, "rationale": "Order exotic items.", "lines": [{"ingredient_id": 777, "qty": "9", "reason": "truffle oil"}]}]}, "expect": {"qty": {"3": "6"}, "violation_kinds": ["unknown", "omitted"]}}
{"id": "inv-004", "kind": "adversarial", "desc": "hoarding capped at 3x deficit", "needs": [{"id": 2, "name": "urad dal", "unit": "kg", "deficit": "4", "supplier_id": 5}], "batch": {"drafts": [{"supplier_id": 5, "rationale": "Buy a year of dal.", "lines": [{"ingredient_id": 2, "qty": "400", "reason": "bulk discount"}]}]}, "expect": {"qty": {"2": "12"}, "violation_kinds": ["capped"]}}
{"id": "inv-005", "kind": "adversarial", "desc": "under-order raised to deficit", "needs": [{"id": 1, "name": "idli rice", "unit": "kg", "deficit": "10", "supplier_id": 5}], "batch": {"drafts": [{"supplier_id": 5, "rationale": "Just a little rice.", "lines": [{"ingredient_id": 1, "qty": "2", "reason": "save money"}]}]}, "expect": {"qty": {"1": "10"}, "violation_kinds": ["raised"]}}
{"id": "inv-006", "kind": "adversarial", "desc": "duplicate ingredient lines collapse to first", "needs": [{"id": 1, "name": "idli rice", "unit": "kg", "deficit": "10", "supplier_id": 5}], "batch": {"drafts": [{"supplier_id": 5, "rationale": "Restock.", "lines": [{"ingredient_id": 1, "qty": "11", "reason": "first"}]}, {"supplier_id": null, "rationale": "Also rice.", "lines": [{"ingredient_id": 1, "qty": "30", "reason": "second"}]}]}, "expect": {"qty": {"1": "11"}, "violation_kinds": ["duplicate"]}}
{"id": "inv-007", "kind": "adversarial", "desc": "omitted short ingredient force-added at deficit", "needs": [{"id": 1, "name": "idli rice", "unit": "kg", "deficit": "10", "supplier_id": 5}, {"id": 4, "name": "coconut", "unit": "kg", "deficit": "3", "supplier_id": 6}], "batch": {"drafts": [{"supplier_id": 5, "rationale": "Rice only.", "lines": [{"ingredient_id": 1, "qty": "10", "reason": "deficit"}]}]}, "expect": {"qty": {"1": "10", "4": "3"}, "violation_kinds": ["omitted"]}}
{"id": "inv-008", "kind": "valid", "desc": "multi-supplier regrouped by canonical supplier despite wrong llm grouping", "needs": [{"id": 1, "name": "idli rice", "unit": "kg", "deficit": "10", "supplier_id": 5}, {"id": 4, "name": "coconut", "unit": "kg", "deficit": "3", "supplier_id": 6}], "batch": {"drafts": [{"supplier_id": 6, "rationale": "One order.", "lines": [{"ingredient_id": 1, "qty": "12", "reason": "deficit"}, {"ingredient_id": 4, "qty": "4", "reason": "deficit"}]}]}, "expect": {"qty": {"1": "12", "4": "4"}, "violation_kinds": [], "groups": {"5": [1], "6": [4]}}}
{"id": "inv-009", "kind": "valid", "desc": "unassigned supplier goes to its own null group", "needs": [{"id": 3, "name": "milk", "unit": "l", "deficit": "6", "supplier_id": null}, {"id": 1, "name": "idli rice", "unit": "kg", "deficit": "10", "supplier_id": 5}], "batch": {"drafts": [{"supplier_id": 5, "rationale": "Restock.", "lines": [{"ingredient_id": 1, "qty": "10", "reason": "deficit"}, {"ingredient_id": 3, "qty": "8", "reason": "deficit"}]}]}, "expect": {"qty": {"1": "10", "3": "8"}, "violation_kinds": [], "groups": {"5": [1], "null": [3]}}}
{"id": "inv-010", "kind": "valid", "desc": "boundary: exactly deficit accepted without violation", "needs": [{"id": 2, "name": "urad dal", "unit": "kg", "deficit": "4", "supplier_id": 5}], "batch": {"drafts": [{"supplier_id": 5, "rationale": "Exact.", "lines": [{"ingredient_id": 2, "qty": "4", "reason": "exact deficit"}]}]}, "expect": {"qty": {"2": "4"}, "violation_kinds": []}}
{"id": "inv-011", "kind": "valid", "desc": "boundary: exactly 3x deficit accepted without violation", "needs": [{"id": 2, "name": "urad dal", "unit": "kg", "deficit": "4", "supplier_id": 5}], "batch": {"drafts": [{"supplier_id": 5, "rationale": "Festival buffer.", "lines": [{"ingredient_id": 2, "qty": "12", "reason": "Pongal week"}]}]}, "expect": {"qty": {"2": "12"}, "violation_kinds": []}}
{"id": "inv-012", "kind": "adversarial", "desc": "negative-ish tiny decimal raised to deficit", "needs": [{"id": 3, "name": "milk", "unit": "l", "deficit": "6.500", "supplier_id": null}], "batch": {"drafts": [{"supplier_id": null, "rationale": "Minimal.", "lines": [{"ingredient_id": 3, "qty": "0.001", "reason": "token order"}]}]}, "expect": {"qty": {"3": "6.500"}, "violation_kinds": ["raised"]}}
{"id": "inv-013", "kind": "valid", "desc": "decimal quantities preserved inside band", "needs": [{"id": 7, "name": "ghee", "unit": "kg", "deficit": "1.250", "supplier_id": 8}], "batch": {"drafts": [{"supplier_id": 8, "rationale": "Ghee roast dosas trending.", "lines": [{"ingredient_id": 7, "qty": "2.5", "reason": "1.25 kg deficit rounded to 2.5 kg tin"}]}]}, "expect": {"qty": {"7": "2.5"}, "violation_kinds": []}}
{"id": "inv-014", "kind": "adversarial", "desc": "mixed abuse: hallucination + hoard + duplicate + omission in one batch", "needs": [{"id": 1, "name": "idli rice", "unit": "kg", "deficit": "10", "supplier_id": 5}, {"id": 2, "name": "urad dal", "unit": "kg", "deficit": "4", "supplier_id": 5}, {"id": 3, "name": "milk", "unit": "l", "deficit": "6", "supplier_id": null}], "batch": {"drafts": [{"supplier_id": 5, "rationale": "Big shop.", "lines": [{"ingredient_id": 888, "qty": "3", "reason": "ghost"}, {"ingredient_id": 1, "qty": "500", "reason": "hoard"}]}, {"supplier_id": null, "rationale": "More rice.", "lines": [{"ingredient_id": 1, "qty": "10", "reason": "dup"}]}]}, "expect": {"qty": {"1": "30", "2": "4", "3": "6"}, "violation_kinds": ["unknown", "capped", "duplicate", "omitted"]}}
