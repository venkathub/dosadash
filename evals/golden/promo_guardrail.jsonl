{"id": "promo-001", "kind": "clean", "desc": "valid draft on a mined pair passes with price kept", "pairs": [{"item_ids": [3, 12], "names": ["Masala Dosa", "Filter Coffee"], "parts_total": "180.00", "times_ordered": 41}], "batch": {"combos": [{"item_ids": [3, 12], "name": "Kaapi Combo", "price": "165.00", "rationale": "Ordered together 41 times"}], "coupons": []}, "expect": {"combo_names": ["Kaapi Combo"], "combo_prices": ["165.00"]}}
{"id": "promo-002", "kind": "hallucination", "desc": "pair the mining never produced is dropped, mined pair force-added", "pairs": [{"item_ids": [3, 12], "names": ["Masala Dosa", "Filter Coffee"], "parts_total": "180.00", "times_ordered": 41}], "batch": {"combos": [{"item_ids": [98, 99], "name": "Ghost Combo", "price": "100.00", "rationale": "invented"}], "coupons": []}, "expect": {"combo_names": ["Masala Dosa + Filter Coffee Combo"], "combo_prices": ["162.00"]}}
{"id": "promo-003", "kind": "clamp_low", "desc": "free-food combo price clamped up to 85% of parts", "pairs": [{"item_ids": [3, 12], "names": ["Masala Dosa", "Filter Coffee"], "parts_total": "200.00", "times_ordered": 10}], "batch": {"combos": [{"item_ids": [3, 12], "name": "Steal Deal", "price": "20.00", "rationale": "x"}], "coupons": []}, "expect": {"combo_prices": ["170.00"]}}
{"id": "promo-004", "kind": "clamp_high", "desc": "non-deal price clamped down to 97% of parts", "pairs": [{"item_ids": [3, 12], "names": ["Masala Dosa", "Filter Coffee"], "parts_total": "200.00", "times_ordered": 10}], "batch": {"combos": [{"item_ids": [3, 12], "name": "Fake Deal", "price": "260.00", "rationale": "x"}], "coupons": []}, "expect": {"combo_prices": ["194.00"]}}
{"id": "promo-005", "kind": "dedupe", "desc": "same pair drafted twice keeps only the first", "pairs": [{"item_ids": [3, 12], "names": ["Masala Dosa", "Filter Coffee"], "parts_total": "180.00", "times_ordered": 41}], "batch": {"combos": [{"item_ids": [3, 12], "name": "First", "price": "165.00", "rationale": "x"}, {"item_ids": [12, 3], "name": "Second", "price": "160.00", "rationale": "x"}], "coupons": []}, "expect": {"combo_names": ["First"]}}
{"id": "promo-006", "kind": "coupon_clamp", "desc": "80% coupon clamped to the 30% band, cap defaulted", "pairs": [], "batch": {"combos": [], "coupons": [{"code": "MEGA80", "type": "PCT", "value": "80", "max_discount": null, "min_subtotal": null, "description": "80% off everything", "rationale": "x"}]}, "stats": {"slow_day": "Tuesday", "median_aov": "310.00", "existing_codes": []}, "expect": {"coupon_values": ["30.00"], "coupon_caps_present": true}}
{"id": "promo-007", "kind": "coupon_floor", "desc": "FLAT coupon gets the no-free-food min_subtotal floor", "pairs": [], "batch": {"combos": [], "coupons": [{"code": "FLAT100", "type": "FLAT", "value": "100", "max_discount": null, "min_subtotal": "50", "description": "₹100 off", "rationale": "x"}]}, "stats": {"slow_day": "Tuesday", "median_aov": "310.00", "existing_codes": []}, "expect": {"coupon_min_subtotals": ["200.00"]}}
{"id": "promo-008", "kind": "code_normalize", "desc": "messy code normalized, collision suffixed", "pairs": [], "batch": {"combos": [], "coupons": [{"code": "try me!", "type": "PCT", "value": "15", "max_discount": "75", "min_subtotal": null, "description": "deal", "rationale": "x"}, {"code": "TRYME", "type": "PCT", "value": "10", "max_discount": "50", "min_subtotal": null, "description": "deal", "rationale": "x"}]}, "stats": {"slow_day": "Tuesday", "median_aov": "310.00", "existing_codes": []}, "expect": {"coupon_codes": ["TRYME", "TRYME2"]}}
