# DosaDash — local live-eval environment template
#
# Copy to `.env.eval` (gitignored) and fill in real keys, then run:
#     bash scripts/run-live-evals.sh
#
# The script prepares an isolated `dosadash_eval` database on the local
# test Postgres container (pgvector/pgvector:pg16 on :5433 — the same one
# pytest uses, but a separate database so test runs never clobber it),
# applies migrations, seeds the menu, ingests knowledge/, and runs the
# three live suites: retrieval, rag_answer, order_agent.

# --- LLM provider keys (read by litellm straight from the environment) ---
OPENAI_API_KEY=            # required (primary model + embeddings)
GROQ_API_KEY=              # optional (fallback tier — chain degrades without it)
GEMINI_API_KEY=            # optional (fallback tier)

# --- Langfuse tracing (optional but recommended: verifies Hard Rule 6) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Eval database (defaults are correct for the local test container) ---
# docker run -d --name dosadash-test-pg -p 5433:5432 \
#   -e POSTGRES_USER=dosadash -e POSTGRES_PASSWORD=dosadash \
#   -e POSTGRES_DB=dosadash pgvector/pgvector:pg16
#EVAL_DATABASE_URL=postgresql+asyncpg://dosadash:dosadash@localhost:5433/dosadash_eval

# --- Thresholds (defaults shown; Phase 4 gates order_accuracy at 0.95) ---
#PASS_THRESHOLD=0.8
#TOP_K=4
