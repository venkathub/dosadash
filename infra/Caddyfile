# TLS is terminated by the AIC Cloud front proxy (ports 80/443 are provider-
# reserved). Caddy serves plain HTTP internally and only does path routing.
:80 {
	encode gzip

	# Core API (REST + WebSockets)
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /ws/* {
		reverse_proxy api:8000
	}
	handle /healthz {
		reverse_proxy api:8000
	}

	# Owner-approved AI dish photos (Phase 7) — static files from the api
	handle /media/* {
		reverse_proxy api:8000
	}

	# AI service (agents, RAG, SSE streaming)
	handle_path /ai/* {
		reverse_proxy ai:8001
	}

	# Remote MCP endpoint (Phase 16) — hosted Streamable HTTP MCP server
	# (admin-issued key auth lives in the ai service, not here)
	handle /mcp* {
		reverse_proxy ai:8001
	}

	# Telegram webhook (aiogram bot adapter)
	handle /tg/* {
		reverse_proxy bot:8081
	}

	# Next.js: customer /, KDS /kds, admin /admin
	handle {
		reverse_proxy web:3000
	}
}
