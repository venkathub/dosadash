# Copy to infra/.env on the VPS (and locally). Never commit real values.

ENV=prod

# Host port that Caddy listens on. AIC Cloud's front proxy forwards
# dosadash.venkateshs.dev (80/443, TLS at the proxy) to this port.
HTTP_PORT=8080

POSTGRES_USER=dosadash
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dosadash

# JWT signing secret for the API (generate: openssl rand -hex 32)
JWT_SECRET=change-me

# --- LLM providers (Phase 2+: nutrition enrichment; Phase 3: order agent) ---
# litellm routing chain: gpt-4o-mini → Groq Llama 3.3 → Gemini Flash.
# At least OPENAI_API_KEY is needed for enrichment; others enable fallbacks.
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Langfuse Cloud tracing (Hard Rule 6) — tracing is skipped if left empty
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
TELEGRAM_BOT_TOKEN=
# Shared secret for bot→api internal calls (generate: openssl rand -hex 24)
INTERNAL_API_TOKEN=
RAZORPAY_KEY_ID=        # rzp_test_... — TEST keys only (Hard Rule 9)
RAZORPAY_KEY_SECRET=    # TEST keys only
RAZORPAY_WEBHOOK_SECRET=

# Shared durable AI admission limits (UTC days; unknown costs retain estimates).
# Not a provider billing hard cap; configure provider-side caps as well.
AI_PROVIDER_BUDGET_ENABLED=true
AI_PROVIDER_DAILY_BUDGET_USD=5
AI_PROVIDER_DAILY_MAX_CALLS=1000

# Local classifier can be re-enabled for a reviewed experiment; default LLM scoring.
AI_REVIEW_LOCAL_ENABLED=false
# Estimates reserve allowance, not guaranteed provider prices. Default per attempt:
# chat/batch $0.02, embedding $0.005, audio $0.02, image $0.10.
